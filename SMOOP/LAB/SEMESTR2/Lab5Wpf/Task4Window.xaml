<Window x:Class="Lab5Wpf.Task4Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завдання 4 — Сховай усі кнопки"
        Width="640" Height="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Сховай усі кнопки!" FontSize="24" FontWeight="Bold"
                       Foreground="#FF2B3A55" HorizontalAlignment="Center"/>
            <TextBlock Text="Кожне натискання ховає кнопку, але випадково перемикає видимість інших."
                       FontSize="13" Foreground="#FF6B7790" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="MovesText" Text="Ходів: 0" FontSize="16"
                       VerticalAlignment="Center" Foreground="#FF2B3A55"/>
            <Button Content="Нова гра" Click="NewGameButton_Click"
                    HorizontalAlignment="Right" Background="#FFDCE8FF"/>
        </Grid>

        <Border Background="White" BorderBrush="#FFCBD3E1" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <WrapPanel x:Name="GamePanel" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Content="Червона" Background="#FFE53935" Foreground="White"
                        Width="140" Height="60" FontSize="18" FontWeight="Bold" Margin="8"/>

                <Button Content="Зелена" Background="#FF43A047" Foreground="White"
                        Width="110" Height="80" FontSize="22" FontStyle="Italic" Margin="8"/>

                <Button Content="Синя" Background="#FF1E88E5" Foreground="White"
                        Width="170" Height="50" FontSize="16" FontFamily="Consolas" Margin="8"/>

                <Button Content="Жовта" Background="#FFFDD835" Foreground="#FF333333"
                        Width="120" Height="90" FontSize="26" FontWeight="SemiBold" Margin="8"/>

                <Button Content="Фіолетова" Background="#FF8E24AA" Foreground="White"
                        Width="150" Height="70" FontSize="20" FontFamily="Georgia" FontStyle="Italic" Margin="8"/>

            </WrapPanel>
        </Border>

    </DockPanel>
</Window>
