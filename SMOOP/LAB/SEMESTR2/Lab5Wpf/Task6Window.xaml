<Window x:Class="Lab5Wpf.Task6Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завдання 6 — Алхімічна лабораторія кольорів"
        Width="620" Height="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Алхімічна лабораторія кольорів" FontSize="24" FontWeight="Bold"
                   Foreground="#FF2B3A55" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" x:Name="RecipeText" FontSize="16" Margin="0,10,0,10"
                   Foreground="#FF6B7790" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Магічні кристали -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Ваш кристал" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Rectangle x:Name="MixRect" Width="150" Height="110" RadiusX="14" RadiusY="14"
                           Stroke="#FF2B3A55" StrokeThickness="2" Fill="Black"/>
                <TextBlock Text="Цільовий колір" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <Rectangle x:Name="TargetRect" Width="150" Height="50" RadiusX="10" RadiusY="10"
                           Stroke="#FF2B3A55" StrokeThickness="1" Fill="Gray"/>
            </StackPanel>

            <!-- Повзунки -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock x:Name="RedLabel" Text="Red: 0" Foreground="#FFC62828" FontWeight="SemiBold"/>
                <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" Margin="0,2,0,12"/>

                <TextBlock x:Name="GreenLabel" Text="Green: 0" Foreground="#FF2E7D32" FontWeight="SemiBold"/>
                <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" Margin="0,2,0,12"/>

                <TextBlock x:Name="BlueLabel" Text="Blue: 0" Foreground="#FF1565C0" FontWeight="SemiBold"/>
                <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="Slider_ValueChanged" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="#FF6B7790"/>
            <Button Content="Новий рецепт" Click="NewRecipeButton_Click"
                    HorizontalAlignment="Right" Background="#FFDCE8FF"/>
        </Grid>
    </Grid>
</Window>
