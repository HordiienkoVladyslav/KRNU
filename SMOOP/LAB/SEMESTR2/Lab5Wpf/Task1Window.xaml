<Window x:Class="Lab5Wpf.Task1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завдання 1 — Зміна тексту"
        Width="460" Height="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Привіт" Click="HelloButton_Click" Background="#FFDCE8FF" MinWidth="130"/>
            <Button Content="До побачення" Click="ByeButton_Click" Background="#FFFFE3D6" MinWidth="130"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Background="White"
                BorderBrush="#FFCBD3E1" BorderThickness="1" CornerRadius="8" Padding="16">
            <TextBlock x:Name="OutputText" Text="Початок роботи"
                       FontSize="30" FontWeight="SemiBold" Foreground="#FF2B3A55"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
