<Window x:Class="Lab5Wpf.Task3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завдання 3 — Очищення та видимість TextBox"
        Width="500" Height="300"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button Content="Приховати" Click="HideButton_Click" Background="#FFFFDDDD" MinWidth="110"/>
            <Button Content="Показати" Click="ShowButton_Click" Background="#FFDDF3E4" MinWidth="110"/>
            <Button Content="Очистити" Click="ClearButton_Click" Background="#FFFFF1CC" MinWidth="110"/>
        </StackPanel>

        <TextBox x:Name="InputBox" Text="Введіть щось тут..."
                 MinHeight="40" VerticalContentAlignment="Center"/>

    </StackPanel>
</Window>
