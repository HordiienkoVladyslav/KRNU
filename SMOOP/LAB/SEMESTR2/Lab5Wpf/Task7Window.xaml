<Window x:Class="Lab5Wpf.Task7Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завдання 7 — Злом сейфу"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва частина: керування -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Злом сейфу" FontSize="26" FontWeight="Bold" Foreground="#FF2B3A55"/>
            <TextBlock Text="Вгадайте 4-значний код (1000–9999)." FontSize="13"
                       Foreground="#FF6B7790" Margin="0,2,0,14"/>

            <TextBlock x:Name="AttemptsText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBox x:Name="GuessBox" MaxLength="4" FontSize="28" FontFamily="Consolas"
                     TextAlignment="Center" PreviewTextInput="GuessBox_PreviewTextInput"/>

            <Button x:Name="CheckButton" Content="Перевірити" IsDefault="True"
                    Click="CheckButton_Click" Background="#FFDCE8FF" Margin="0,10,0,10"/>

            <Border Background="White" BorderBrush="#FFCBD3E1" BorderThickness="1"
                    CornerRadius="8" Padding="10" MinHeight="70">
                <TextBlock x:Name="HintText" FontSize="16" TextWrapping="Wrap"
                           Text="Введіть код і натисніть «Перевірити»."/>
            </Border>

            <CheckBox x:Name="XrayCheck" Content="Увімкнути рентген (коштує 1 спробу)"
                      FontSize="14" Margin="0,14,0,6"
                      Checked="XrayCheck_Checked" Unchecked="XrayCheck_Unchecked"/>

            <Label x:Name="XrayLabel" Content="Рентген вимкнено" FontSize="16" FontFamily="Consolas"
                   Background="#FF1B2433" Foreground="#FF7CFFB2" Padding="10,6"/>

            <Button Content="Нова гра" Click="NewGameButton_Click"
                    Background="#FFFFF1CC" Margin="0,14,0,0" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Права частина: історія -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Історія спроб" FontSize="18" FontWeight="SemiBold"
                       Foreground="#FF2B3A55" Margin="0,0,0,6"/>
            <ListBox x:Name="HistoryList" FontFamily="Consolas" FontSize="14"/>
        </DockPanel>
    </Grid>
</Window>
