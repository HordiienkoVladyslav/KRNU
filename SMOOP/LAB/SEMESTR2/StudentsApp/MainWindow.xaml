<Window x:Class="StudentsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudentsApp.ViewModels"
        Title="Список студентів"
        Width="820" Height="480" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <!-- DataContext задається в XAML: Code-Behind містить лише InitializeComponent() -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>

        <!-- Шаблон помилки валідації: червоний текст під полем -->
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="placeholder" />
                <TextBlock Foreground="Firebrick" FontSize="11"
                           Text="{Binding ElementName=placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,2,0,18" />
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ErrorTemplate}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,2,0,18" />
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ErrorTemplate}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- Чергування кольору фону рядків (AlternationCount="2") -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- Зв'язок вибору рядка з моделлю: ViewModel бачить усі вибрані елементи -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="White" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#EAF1FB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Шаблон одного елемента списку: «Прізвище Ім'я» в одному рядку, вік із постфіксом -->
        <DataTemplate x:Key="StudentTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="LastName" />
                                <Binding Path="FirstName" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Gender}" FontSize="11" Opacity="0.7" />
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Text="{Binding Age, StringFormat={}{0} років}" />
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ЛІВА ЧАСТИНА: список -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Вибрати всіх" Margin="0"
                        Padding="8,2" Command="{Binding SelectAllCommand}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Студенти" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                               Text="{Binding SelectedCount, StringFormat={}Вибрано: {0}}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" BorderBrush="#BBBBBB" BorderThickness="1">
                <Grid>
                    <!-- ListBox має вбудоване прокручування -->
                    <ListBox ItemsSource="{Binding Students}"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="False"
                             ItemTemplate="{StaticResource StudentTemplate}"
                             ItemContainerStyle="{StaticResource RowStyle}"
                             AlternationCount="2"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <!-- Порожній список: ховаємо ListBox -->
                                    <DataTrigger Binding="{Binding Students.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>

                    <!-- Порожній список: показуємо повідомлення -->
                    <TextBlock Text="Список порожній. Додайте першого студента."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="14" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Students.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ПРАВА ЧАСТИНА: форма створення / редагування -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Дані студента" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <TextBlock Text="Прізвище" />
                <TextBox Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <TextBlock Text="Ім'я" />
                <TextBox Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <TextBlock Text="Вік (16–100 років)" />
                <TextBox Text="{Binding EditAge, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <TextBlock Text="Стать" />
                <ComboBox ItemsSource="{Binding Genders}"
                          SelectedItem="{Binding EditGender, ValidatesOnDataErrors=True}" />

                <TextBlock Text="{Binding DuplicateError}" Foreground="Firebrick" TextWrapping="Wrap"
                           Margin="0,-12,0,8" />

                <WrapPanel>
                    <Button Content="Додати" Command="{Binding AddCommand}" />
                    <Button Content="Зберегти зміни" Command="{Binding SaveCommand}" />
                    <Button Content="Видалити вибраних" Command="{Binding DeleteCommand}" />
                    <Button Content="Очистити" Command="{Binding NewCommand}" />
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
