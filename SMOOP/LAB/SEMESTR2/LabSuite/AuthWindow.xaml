<Window x:Class="LabSuite.AuthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Акаунт" Width="460" Height="640" Style="{StaticResource Win}" WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14213D" Offset="0"/><GradientStop Color="#4A2C7A" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Border Background="#CC0E1830" CornerRadius="14" Margin="28" Padding="24">
      <StackPanel>
        <StackPanel x:Name="LoginPanel">
          <TextBlock Text="Вхід" FontSize="28" FontWeight="Bold"/>
          <TextBlock Text="Email" Margin="0,16,0,0"/><TextBox x:Name="LEmail"/>
          <TextBlock Text="Пароль" Margin="0,8,0,0"/><PasswordBox x:Name="LPass"/>
          <Button Content="Увійти" Style="{StaticResource Accent}" Margin="0,16,0,3" Click="Login"/>
          <Button Content="Продовжити з Google" Click="Google"/>
          <Button Content="Немає акаунта? Зареєструватися" Background="Transparent" Click="ShowReg"/>
        </StackPanel>
        <StackPanel x:Name="RegPanel" Visibility="Collapsed">
          <TextBlock Text="Реєстрація" FontSize="28" FontWeight="Bold"/>
          <TextBlock Text="Ім'я" Margin="0,12,0,0"/><TextBox x:Name="RName"/>
          <TextBlock Text="Email" Margin="0,6,0,0"/><TextBox x:Name="REmail"/>
          <TextBlock Text="Пароль (від 8 символів, літери й цифри)" Margin="0,6,0,0"/><PasswordBox x:Name="RPass"/>
          <TextBlock Text="Повторіть пароль" Margin="0,6,0,0"/><PasswordBox x:Name="RPass2"/>
          <Button Content="Створити акаунт" Style="{StaticResource Accent}" Margin="0,16,0,3" Click="Register"/>
          <Button Content="Уже є акаунт? Увійти" Background="Transparent" Click="ShowLogin"/>
        </StackPanel>
        <TextBlock x:Name="Msg" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
