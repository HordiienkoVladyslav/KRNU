<Window x:Class="LabSuite.SniperWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Нічний Снайпер" Width="460" Height="600" Background="#02030A" Style="{StaticResource Win}">
  <Window.Resources>
    <Style x:Key="Cell" TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#05070D" BorderBrush="#101828" BorderThickness="1" CornerRadius="4" Margin="3">
              <TextBlock x:Name="ic" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background">
                  <Setter.Value>
                    <RadialGradientBrush>
                      <GradientStop Color="#FFF3B0" Offset="0"/><GradientStop Color="#6B5B1E" Offset="0.45"/><GradientStop Color="#05070D" Offset="1"/>
                    </RadialGradientBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="Tag" Value="hit">
                <Setter TargetName="bd" Property="Background" Value="#0F3D22"/>
                <Setter TargetName="ic" Property="Text" Value="◎"/><Setter TargetName="ic" Property="Foreground" Value="#39FF7A"/>
              </Trigger>
              <Trigger Property="Tag" Value="miss">
                <Setter TargetName="bd" Property="Background" Value="#3A0D12"/>
                <Setter TargetName="ic" Property="Text" Value="✕"/><Setter TargetName="ic" Property="Foreground" Value="#FF4A55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Status" FontSize="18" TextWrapping="Wrap"/>
    <UniformGrid x:Name="Field" Grid.Row="1" Rows="4" Columns="4" Margin="0,12"/>
    <Button Grid.Row="2" Content="Нова гра" Style="{StaticResource Accent}" Click="NewGame"/>
  </Grid>
</Window>
