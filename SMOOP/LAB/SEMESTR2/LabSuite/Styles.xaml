<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#14213D"/>
  <SolidColorBrush x:Key="Panel" Color="#1F2F52"/>
  <SolidColorBrush x:Key="Amber" Color="#FCA311"/>
  <SolidColorBrush x:Key="Paper" Color="#F1F1EC"/>

  <Style x:Key="Win" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Ink}"/>
    <Setter Property="Foreground" Value="{DynamicResource Paper}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="15"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Paper}"/>
    <Setter Property="Background" Value="{DynamicResource Panel}"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.6"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Amber}"/>
    <Setter Property="Foreground" Value="#14213D"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#0E1830"/>
    <Setter Property="Foreground" Value="{DynamicResource Paper}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Paper}"/>
    <Setter Property="BorderBrush" Value="#3A5086"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="#0E1830"/>
    <Setter Property="Foreground" Value="{DynamicResource Paper}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Paper}"/>
    <Setter Property="BorderBrush" Value="#3A5086"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>
</ResourceDictionary>
