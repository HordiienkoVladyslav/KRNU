<Window x:Class="LabSuite.Game2048Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="2048" Width="440" Height="600" Style="{StaticResource Win}" PreviewKeyDown="Keyed">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Нова гра" Style="{StaticResource Accent}" Click="NewGame" Focusable="False"/>
      <StackPanel><TextBlock x:Name="ScoreText" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="BestText" Opacity="0.7"/></StackPanel>
    </DockPanel>
    <UniformGrid x:Name="Board" Grid.Row="1" Rows="4" Columns="4" Margin="0,12"/>
    <TextBlock x:Name="Status" Grid.Row="2" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Amber}" HorizontalAlignment="Center" Text="Грайте стрілками"/>
  </Grid>
</Window>
